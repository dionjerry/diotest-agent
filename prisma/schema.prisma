generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrationType {
  GITHUB
  JIRA
  TRELLO
  GOOGLE_SHEETS
}

enum RepositoryProvider {
  GITHUB
  GITLAB
}

enum SettingScope {
  SYSTEM
  ORGANIZATION
  PROJECT
}

model User {
  id              String               @id @default(cuid())
  name            String?
  email           String               @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  accounts        Account[]
  sessions        Session[]
  organizations   OrganizationMember[]
  resetTokens     PasswordResetToken[]
  sentInvites     OrganizationInvite[] @relation("SentInvites")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      OrganizationMember[]
  projects     Project[]
  settings     SystemSetting[]
  encryptedSecrets EncryptedSecret[]
  invites      OrganizationInvite[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("owner")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("member")
  token          String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("SentInvites", fields: [invitedById], references: [id])
}

model Project {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubConnection GithubConnection?
  repositoryConnection RepositoryConnection?
  integrations   IntegrationConnection[]
  settings       SystemSetting[]
  encryptedSecrets EncryptedSecret[]
  actions          AgentAction[]
  tasks            Task[]
  recorderSessions    RecorderSession[]
  analysisSessions    AnalysisSession[]
  recorderScreenshots RecorderScreenshot[]
  agentThreads        AgentThread[]

  @@unique([organizationId, slug])
}

model AgentThread {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    AgentMessage[]
  toolCalls   AgentToolCall[]

  @@index([projectId, updatedAt])
}

model AgentMessage {
  id        String      @id @default(cuid())
  threadId   String
  role      String
  content   String
  meta      Json?
  createdAt DateTime    @default(now())
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model GithubConnection {
  id              String   @id @default(cuid())
  projectId       String   @unique
  repositoryOwner String
  repositoryName  String
  defaultBranch   String
  installationId  String?
  webhookStatus   String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RepositoryConnection {
  id                 String             @id @default(cuid())
  projectId          String             @unique
  provider           RepositoryProvider
  externalId         String
  owner              String
  namespace          String?
  repositoryName     String
  fullName           String
  repositoryUrl      String
  defaultBranch      String
  installationId     String?
  providerUser       String?
  webhookId          String?
  webhookStatus      String             @default("pending")
  webhookUrl         String?
  webhookLastError   String?
  lastSyncedAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model IntegrationConnection {
  id          String          @id @default(cuid())
  projectId   String
  type        IntegrationType
  name        String
  configJson  Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
}

model SystemSetting {
  id             String       @id @default(cuid())
  scope          SettingScope
  organizationId String?
  projectId      String?
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([scope, organizationId, projectId, key])
}

model EncryptedSecret {
  id             String        @id @default(cuid())
  scope          SettingScope
  organizationId String?
  projectId      String?
  key            String
  cipherText     String
  iv             String
  tag            String
  algorithm      String        @default("aes-256-gcm")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([scope, organizationId, projectId, key])
}

model RecorderScreenshot {
  id                 String   @id @default(cuid())
  projectId          String
  extensionSessionId String
  stepId             String
  mimeType           String   @default("image/jpeg")
  data               Bytes
  createdAt          DateTime @default(now())
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([extensionSessionId, stepId])
  @@index([extensionSessionId])
}

model RecorderSession {
  id                 String    @id @default(cuid())
  projectId          String
  extensionSessionId String    @unique
  name               String
  domain             String
  startUrl           String
  lastUrl            String
  status             String
  steps              Json
  pageSummaries      Json?
  generated          Json?
  lastGenerationOptions Json?
  warnings           Json      @default("[]")
  screenshotsCaptured Int      @default(0)
  storageTrimmed     Boolean   @default(false)
  startedAt          DateTime
  stoppedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AnalysisSession {
  id                 String    @id @default(cuid())
  projectId          String
  extensionRunId     String    @unique
  threadId           String
  repo               String
  ref                String
  pageType           String
  title              String?
  url                String?
  mode               String
  coverageLevel      String
  analysisQuality    String
  riskScore          Float
  riskAreas          Json
  testPlan           Json
  manualTestCases    Json
  debug              Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AgentToolCall {
  id         String      @id @default(cuid())
  threadId   String
  tool       String
  inputJson  Json
  outputJson Json?
  durationMs Int?
  status     String      @default("used")
  createdAt  DateTime    @default(now())
  thread     AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AgentAction {
  id               String    @id @default(cuid())
  projectId        String
  type             String
  target           String
  targetId         String?
  title            String
  description      String
  readOnly         Boolean   @default(false)
  approvalRequired Boolean   @default(true)
  status           String    @default("awaiting_approval")
  input            Json
  result           Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]
}

model Task {
  id          String      @id @default(cuid())
  projectId   String
  actionId    String?
  type        String
  status      String      @default("queued")
  title       String
  input       Json
  output      Json?
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action      AgentAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
}
